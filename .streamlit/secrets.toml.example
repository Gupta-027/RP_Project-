# Streamlit Community Cloud: paste these into the app's Settings -> Secrets box.
# Do NOT commit the real secrets.toml file.

GEMINI_API_KEY = "your_api_key_here"
GEMINI_MODEL = "gemini-3.5-flash-lite"

# all-MiniLM-L6-v2 uses about 500 MB of RAM and fits the free tier.
# all-mpnet-base-v2 is more accurate but uses about 800 MB and may run out.
EMBEDDING_MODEL = "all-MiniLM-L6-v2"
